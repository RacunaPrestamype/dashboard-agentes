# Copiar a .env y completar. Nada de esto es obligatorio: sin la variable de un
# agente, ese agente sale marcado «sin datos» en el tablero y el otro se muestra
# igual.

# --- LeIA (SQLite) ---------------------------------------------------------
# Carpeta del host que contiene gestora.db (se monta en /datos/leia).
LEIA_DB_DIR=../LeIA/db
# Cuentas internas que no cuentan como uso. Se comparan contra la parte local
# del correo (antes de @), en minúsculas.
LEIA_EXCLUIR_USUARIOS=dacuna,admin,cpardave,dbaldeon

# --- Indicadores GDP (Postgres) --------------------------------------------
# El rol `tablero` del agente GDP: solo SELECT. Nunca el rol `agente`.
# En Docker con la red del agente compartida: @db:5432. Desde el host: @localhost:PUERTO.
GDP_BD_URL=postgresql://tablero:dev-solo-local@localhost:5432/agente
GDP_EXCLUIR_EMAILS=evaluacion@prestamype.com,qa@prestamype.com

# --- Servidor --------------------------------------------------------------
PUERTO_TABLERO=8095
