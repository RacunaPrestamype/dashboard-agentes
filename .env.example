# Copiar a .env y completar. Nada de esto es obligatorio: sin lo de un agente,
# ese agente sale marcado «sin datos» en el tablero y los otros se muestran
# igual.

# --- LeIA (SQLite) ---------------------------------------------------------
# Fuera de Docker: el archivo. En Docker: el volumen del stack de LeIA.
LEIA_DB_PATH=../LeIA/db/gestora.db
LEIA_VOLUMEN=leia-db-data
# Cuentas internas que no cuentan como uso. Se comparan contra la parte local
# del correo (antes de @), en minúsculas.
LEIA_EXCLUIR_USUARIOS=dacuna,admin,cpardave,dbaldeon

# --- Indicadores GDP (Postgres) --------------------------------------------
# El rol `tablero` del agente GDP: solo SELECT. Nunca el rol `agente`.
# En Docker con la red del agente compartida: @db:5432. Desde el host: @localhost:5432.
GDP_BD_URL=postgresql://tablero:dev-solo-local@localhost:5432/agente
GDP_EXCLUIR_EMAILS=evaluacion@prestamype.com,qa@prestamype.com
RED_GDP=agente_indicadores_gdp_interna

# --- Agente CS (Bedrock AgentCore) -----------------------------------------
# Sesión de AWS del host (MFA). Si venció, este agente queda «sin datos».
AWS_PROFILE=prod
AWS_DIR=~/.aws
ANALYST_MEMORY_ID=prod_analyst_agent_memory-gHFPoM4f9d
# Los nombres salen del user pool de Cognito (actorId = sub). Se puede fijar el
# pool a mano; si no, se busca por nombre.
# ANALYST_COGNITO_POOL=us-east-1_5afSLPvvR
# Vacío: todavía no se decidió qué cuentas de este agente son de prueba.
ANALYST_EXCLUIR_USUARIOS=

# --- Servidor --------------------------------------------------------------
PUERTO_TABLERO=8095
# El uid del host, para que el contenedor pueda leer ~/.aws (es 0600 de su dueño).
UID_HOST=1000
GID_HOST=1000
